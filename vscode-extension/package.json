{
  "name": "dbgjs-vscode",
  "displayName": "dbgjs",
  "description": "Prototype VS Code client for the dbgjs CDP debugger daemon.",
  "version": "0.0.1",
  "private": true,
  "publisher": "hediet",
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Debuggers"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onStartupFinished",
    "onDebugResolve:dbgjs",
    "onView:dbgjs.targets",
    "onCommand:dbgjs.refreshTargets"
  ],
  "contributes": {
    "commands": [
      {
        "command": "dbgjs.refreshTargets",
        "title": "dbgjs: Refresh Targets",
        "icon": "$(refresh)"
      },
      {
        "command": "dbgjs.copyContextId",
        "title": "dbgjs: Copy Workspace Context ID"
      }
    ],
    "configuration": {
      "title": "dbgjs",
      "properties": {
        "dbgjs.serviceStatePath": {
          "type": "string",
          "description": "Path to the dbgjs-service endpoint state file. Defaults to DBGJS_SERVICE_STATE or the platform dbgjs cache location."
        },
        "dbgjs.serviceExecutable": {
          "type": "string",
          "description": "Path to dbgjs-service. Defaults to DBGJS_SERVICE_EXE, the extension's bundled binary, or the repository development build."
        }
      }
    },
    "views": {
      "explorer": [
        {
          "id": "dbgjs.targets",
          "name": "dbgjs Targets",
          "contextualTitle": "dbgjs"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "dbgjs.refreshTargets",
          "when": "view == dbgjs.targets",
          "group": "navigation"
        }
      ]
    },
    "debuggers": [
      {
        "type": "dbgjs",
        "label": "dbgjs Context",
        "languages": [
          "javascript",
          "typescript",
          "javascriptreact",
          "typescriptreact"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "runtime"
            ],
            "properties": {
              "runtime": {
                "type": "string",
                "enum": [
                  "context",
                  "node",
                  "playwright",
                  "chrome"
                ],
                "description": "Runtime to launch, or 'context' to show targets already attached to the workspace context."
              },
              "program": {
                "type": "string",
                "description": "Node.js entry point. Required for runtime 'node'."
              },
              "cwd": {
                "type": "string",
                "description": "Node.js working directory. Defaults to ${workspaceFolder}."
              },
              "runtimeExecutable": {
                "type": "string",
                "default": "node",
                "description": "Node.js executable."
              },
              "runtimeArgs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Arguments passed to Node.js before the inspector and program arguments."
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "description": "Environment overrides for Node.js. Null entries are omitted."
              },
              "url": {
                "type": "string",
                "description": "Page URL for Playwright or Chrome."
              },
              "playwrightPackage": {
                "type": "string",
                "description": "Path to playwright/index.mjs. Defaults to workspace node_modules/playwright/index.mjs."
              },
              "channel": {
                "type": "string",
                "enum": [
                  "bundled",
                  "chrome",
                  "chromeBeta",
                  "chromeDev",
                  "chromeCanary",
                  "msedge",
                  "msedgeBeta",
                  "msedgeDev",
                  "msedgeCanary"
                ],
                "default": "bundled",
                "description": "Playwright browser channel."
              },
              "headless": {
                "type": "boolean",
                "description": "Launch the browser headlessly. Defaults to true for Playwright and false for Chrome."
              },
              "ignoreHttpsErrors": {
                "type": "boolean",
                "default": false,
                "description": "Ignore HTTPS errors in the Playwright browser context."
              },
              "executablePath": {
                "type": "string",
                "description": "Chrome executable. When omitted, the extension searches standard installed Chrome and Chromium locations."
              },
              "userDataDir": {
                "type": "string",
                "description": "Chrome user data directory. A temporary directory is used when omitted."
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Program arguments for Node.js or extra browser arguments for Chrome."
              }
            }
          },
          "attach": {
            "required": [],
            "properties": {
              "runtime": {
                "type": "string",
                "enum": [
                  "context",
                  "target"
                ],
                "default": "context",
                "description": "Expose targets already attached to the workspace dbgjs context."
              },
              "contextId": {
                "type": "string",
                "description": "Internal workspace context identity for a target-bound session."
              },
              "connectionId": {
                "type": "string",
                "description": "Internal connection identity for a target-bound session."
              },
              "connectionGeneration": {
                "type": "integer",
                "minimum": 0,
                "description": "Internal connection generation for a target-bound session."
              },
              "targetId": {
                "type": "string",
                "description": "Internal target identity for a target-bound session."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "dbgjs",
            "request": "launch",
            "name": "Launch Node.js with dbgjs",
            "runtime": "node",
            "program": "${workspaceFolder}/index.js"
          },
          {
            "type": "dbgjs",
            "request": "launch",
            "name": "Launch Playwright with dbgjs",
            "runtime": "playwright",
            "url": "http://localhost:3000",
            "headless": true
          },
          {
            "type": "dbgjs",
            "request": "launch",
            "name": "Launch Chrome with dbgjs",
            "runtime": "chrome",
            "url": "http://localhost:3000"
          },
          {
            "type": "dbgjs",
            "request": "attach",
            "name": "Attach to dbgjs workspace context",
            "runtime": "context"
          }
        ]
      }
    ]
  },
  "scripts": {
    "compile": "node esbuild.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run compile && node --test dist/test/unit.test.cjs",
    "test:heap-streaming": "npm run typecheck && npm run compile && node --test dist/test/heapStreaming.test.cjs",
    "test:vscode": "npm run compile && node test/runIntegration.mjs"
  },
  "dependencies": {
    "@hediet/linkrpc": "0.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.95.0",
    "@vscode/debugprotocol": "^1.68.0",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.2"
  }
}
