{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Launch Node.js with dbgjs",
			"type": "dbgjs",
			"request": "launch",
			"runtime": "node",
			"program": "${workspaceFolder}/node-app.js"
		},
		{
			"name": "Launch compiled TypeScript with dbgjs",
			"type": "dbgjs",
			"request": "launch",
			"runtime": "node",
			"program": "${workspaceFolder}/dist/tsc-app.js",
			"preLaunchTask": "Compile TypeScript example"
		},
		{
			"name": "Launch TypeScript with tsx and dbgjs",
			"type": "dbgjs",
			"request": "launch",
			"runtime": "node",
			"runtimeArgs": [
				"--import",
				"tsx"
			],
			"program": "${workspaceFolder}/tsx-app.ts",
			"preLaunchTask": "Install example dependencies"
		},
		{
			"name": "Launch local page in Chrome with dbgjs",
			"type": "dbgjs",
			"request": "launch",
			"runtime": "chrome",
			"url": "${workspaceFolder}/index.html",
			"headless": false
		},
		{
			"name": "Launch vscode.dev in Chrome with dbgjs",
			"type": "dbgjs",
			"request": "launch",
			"runtime": "chrome",
			"url": "https://vscode.dev",
			"headless": false
		},
		{
			"name": "Attach to persisted dbgjs targets",
			"type": "dbgjs",
			"request": "attach",
			"runtime": "context"
		}
	]
}
