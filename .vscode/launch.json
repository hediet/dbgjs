{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Run VS Code Extension",
			"type": "extensionHost",
			"request": "launch",
			"args": [
				"--extensionDevelopmentPath=${workspaceFolder}/packages/vscode-extension",
				"--disable-extensions",
				"${workspaceFolder}/packages/vscode-extension/test/workspace"
			],
			"outFiles": [
				"${workspaceFolder}/packages/vscode-extension/dist/**/*.js",
				"${workspaceFolder}/packages/vscode-extension/dist/**/*.cjs"
			]
		}
	]
}
