{
  "name": "dbgjs",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:rust && npm run test:offline && npm run test:cdp-session",
    "test:rust": "cargo test --workspace --all-targets",
    "test:offline": "node --test tests/cdp-recording.test.mjs",
    "test:cdp-session": "node tests/cdp-flat-session.mjs",
    "test:e2e": "playwright test",
    "test:e2e:cdp": "playwright test tests/playwright/live-cdp.spec.mjs",
    "test:e2e:bounded-evaluation": "playwright test tests/playwright/bounded-evaluation.spec.mjs",
    "test:e2e:minified-node": "playwright test tests/playwright/minified-node-cli.spec.mjs",
    "test:e2e:context-relay": "playwright test tests/playwright/context-relay-cli.spec.mjs",
    "test:e2e:process-tree-browser": "playwright test tests/playwright/process-tree-browser-cli.spec.mjs",
    "generate:target-tree-transcripts": "node tests/playwright/target-tree-cli-transcripts.mjs",
    "test:e2e:cli": "playwright test tests/playwright/cli-service.spec.mjs",
    "test:e2e:playwright-page": "playwright test tests/playwright/playwright-page-cli.spec.mjs",
    "test:e2e:typescript": "playwright test tests/playwright/typescript-cli.spec.mjs",
    "test:e2e:vscode-coverage": "playwright test tests/playwright/vscode-coverage-cli.spec.mjs",
    "test:e2e:vscode-heap": "playwright test tests/playwright/vscode-heap-cli.spec.mjs",
    "test:e2e:vscode-profile": "playwright test tests/playwright/vscode-profile-cli.spec.mjs",
    "test:e2e:vscode-source-graph": "playwright test tests/playwright/vscode-source-graph-cli.spec.mjs",
    "test:e2e:extension-host-coverage": "playwright test tests/playwright/vscode-extension-host-coverage-cli.spec.mjs",
    "test:e2e:vscode": "playwright test tests/playwright/vscode-dev.spec.mjs",
    "test:e2e:vscode-discovery": "node tests/vscode-discovery/run.mjs",
    "generate:readme": "node tests/readme/run.mjs --update",
    "render:readme": "node tests/readme/transcript.mjs",
    "test:readme": "node tests/readme/run.mjs",
    "test:readme:render": "node --test tests/readme/transcript.test.mjs tests/readme/recorder.test.mjs",
    "generate:contracts": "node scripts/generate-contracts.mjs",
    "check:contracts": "node scripts/generate-contracts.mjs --check",
    "generate:cdp": "cargo run --locked -p cdp-codegen --bin generate-cdp",
    "check:cdp": "cargo run --locked -p cdp-codegen --bin generate-cdp -- --check",
    "prototype:memory": "cargo run --bin source_memory",
    "benchmark:vscode-coverage": "node scripts/vscode-coverage-benchmark.mjs",
    "test:vscode-coverage-benchmark": "node --test scripts/vscode-coverage-benchmark.test.mjs"
  },
  "devDependencies": {
    "@hediet/dbgjs": "^0.1.0-next.20260915.3",
    "@hediet/linkrpc-cli": "0.0.3-next.20260923.1",
    "@playwright/test": "^1.62.1",
    "@vscode/test-electron": "2.5.2",
    "devtools-protocol": "0.0.1677763",
    "electron": "44.4.5",
    "esbuild": "^0.28.2",
    "express": "^5.1.0",
    "typescript": "5.9.2"
  }
}
